# Sao chép thành .env (npm start tự đọc). Không commit .env.
PORT=3000
# Supabase > nút Connect > Session pooler (cổng 5432). Thay mật khẩu; ký tự đặc biệt phải mã hóa URL.
DATABASE_URL=postgresql://postgres.<mã-project>:<MAT_KHAU>@aws-0-<vung>.pooler.supabase.com:5432/postgres
ATTENDANCE_THRESHOLD=0.8
MISSING_HW_ALERT=2
NODE_ENV=development
