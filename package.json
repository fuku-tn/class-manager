{
  "name": "class-manager",
  "version": "0.1.0",
  "description": "Webapp quản lý học viên, điểm danh, bài tập và dashboard theo lớp",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --watch --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/server.js",
    "migrate-pg": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning scripts/migrate-to-postgres.js",
    "import": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning scripts/import-excel.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --test --no-warnings=ExperimentalWarning tests/*.test.js"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
